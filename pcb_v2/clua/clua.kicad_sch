	(text_box "Caso normal de read; primeiro salva INS4-INS0 (com UC_save_src_reg); depois, coloca o conteúdo salvo no barramento (com UC_read_addr_src_reg)\nRD_ADDR0 inverte no high cycle para ler o segundo byte de conteúdos de 16 bits"
		(exclude_from_sim no)
		(at 351.79 20.32 0)
		(size 40.64 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
