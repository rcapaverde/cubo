		)
		(uuid "0ae2ddf4-3d74-4f8d-8f8f-4256d63caa8c")
	)
	(text_box "mem_const = 1100x (24~25) PC\n(usado para colocar em PC um endereço lido da memória durante reset e interrupt)"
		(exclude_from_sim no)
		(at 294.64 87.63 0)
		(size 22.86 15.24)
