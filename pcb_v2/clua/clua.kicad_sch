	)
	(text_box "Caso normal de write; conteúdo INS4-INS0 no barramento quando write_enable ou ula_enable\nWR_ADDR0 inverte no high cycle para escrever o segundo byte de conteúdos de 16 bits"
		(exclude_from_sim no)
		(at 251.46 90.17 0)
		(size 30.48 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
