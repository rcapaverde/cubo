	)
	(text_box "~{int_ready}: habilita o desvio para o tratador de interrupções, caso INT_REQUEST\n~{save_src_reg}: salva INS4-INS0 em RD_ADDR\n~{restart_cycle}: encerra o tratamento da instrução e reinicia um novo ciclo com fetch\n~{save_cond_reg}: compara os flags com INS3-INS0, com base em INS4, e salva o resultado no COND FLAG (que afetará a próxima instrução)\n~{pcia_swap}: inverte o conteúdo dos registradores PC e IA\n~{write_address}: coloca o conteúdo de INS4-INS0 no WR_ADDR\n~{write_enable}: coloca no barramento o sinal WRITE_ENABLE\n~{clear_cond_reg}: limpa o COND FLAG\n~{ula_enable}: coloca no barramento o sinal ULA_ENABLE\n~{extended_code}: habilita o tratamento de opcode extendido, com base no conteúdo de INS4-INS0\n~{read_addr_src_reg}: coloca o conteúdo de SRC REG no RD_ADDR"
		(exclude_from_sim no)
		(at 295.91 264.16 0)
		(size 52.07 46.99)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
