		)
		(uuid "1bb31e9c-c502-42bf-b0ca-6d8329cfb53a")
	)
	(text_box "Quando ~{UC_read_mem_const}, o endereço no barramento poderá ser:\nFFFC: low cycle\nFFFD: high cycle\nFFFE: low cycle durante o reset*\nFFFF: high cycle durante o reset*\n* select_opcode_reset indica a execução de um reset"
		(exclude_from_sim no)
		(at 328.93 144.78 0)
		(size 62.23 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
